# ============================================================
# Kuafor.art — Örnek Ortam Değişkenleri (.env.example)
# ============================================================

# ─── VERİTABANI (Neon / PostgreSQL) ────────────────────────
DATABASE_URL="postgresql://user:password@ep-sample-neon.aws.neon.tech/neondb?sslmode=require"

# ─── REDIS ──────────────────────────────────────────────────
REDIS_URL="rediss://default:token@feasible-cow-112318.upstash.io:6379"

# ─── CLOUDFLARE R2 ──────────────────────────────────────────
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="kuaforart"
R2_PUBLIC_URL="https://cdn.kuafor.art"

# ─── JWT GÜVENLİK ───────────────────────────────────────────
JWT_SECRET="geliştirme-jwt-secret-key-123"

# ─── E-POSTA SERVİSİ (SMTP / Laragon / Mailpit) ─────────────
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="noreply@kuafor.art"

# ─── UYGULAMA & API URL (TÜNEL & GELİŞTİRME) ─────────────────
# Yerel veya Tünel URL'si (Örn: https://kuafor-web.loca.lt)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Yerel veya Tünel API URL'si (Örn: https://kuafor-api.loca.lt)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ─── WEBHOOK & TÜNELLEME YAPILANDIRMASI ──────────────────────
# Meta WhatsApp Cloud API Doğrulama Kodu
WHATSAPP_WEBHOOK_VERIFY_TOKEN="kuafor_art_verify_token"

# Tünel URL'leri (npm run tunnel:api ve tunnel:web çalıştırıldığında)
TUNNEL_API_URL="https://your-api-tunnel.loca.lt"
TUNNEL_WEB_URL="https://your-web-tunnel.loca.lt"

# Webhook Endpoint Formatları
# WhatsApp: POST/GET ${TUNNEL_API_URL}/api/webhooks/whatsapp
# Ödeme: POST ${TUNNEL_API_URL}/api/webhooks/payment

# ─── WHATSAPP & SMS ENTEGRASYON ALANLARI ─────────────────────
WHATSAPP_API_KEY="your-whatsapp-api-key"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-id"
SMS_PROVIDER_API_KEY="your-sms-api-key"

# NetGSM SMS Bilgileri
NETGSM_USERNAME=""
NETGSM_PASSWORD=""

# ─── ÖDEME ALTYAPISI (İyzico / PayTR / POS) ─────────────────
PLATFORM_POS_PROVIDER="iyzico"
PLATFORM_POS_API_KEY="sandbox-api-key"
PLATFORM_POS_SECRET_KEY="sandbox-secret-key"

# ─── CLOUDFLARE ─────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ZONE_ID=""
